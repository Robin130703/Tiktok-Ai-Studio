# Vorlage ohne Werte: nach .env kopieren (wird nicht eingecheckt) und lokal ausfuellen.
# Benoetigt, ausser im Dummy-Modus (npm run make-video -- --dummy)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# nur bei MEDIA_PROVIDER=fal (Standard)
FAL_KEY=
# Optional
# Bildquelle: fal (Standard) oder dummy
MEDIA_PROVIDER=
# Sprache der Stimmen: de (Standard) oder en
VOICE_LANGUAGE=
SCRIPT_MODEL=
# Ausgabe-Token-Limit je Skript-Versuch (Standard 2000)
SCRIPT_MAX_TOKENS=
FFMPEG_PATH=
FFPROBE_PATH=
MAX_COST_PER_VIDEO_USD=
# true/1: Dummy-Modus (Skript, Stimmen, Bilder erfunden, keine Keys, keine Kosten)
PIPELINE_DUMMY=
