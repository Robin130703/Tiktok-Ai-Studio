{
  "name": "tiktok-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Automatische Erstellung von ca. 1-minuetigen KI-Videos",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "script": "node --env-file-if-exists=.env src/script/cli.ts",
    "voice": "node --env-file-if-exists=.env src/voice/cli.ts",
    "media": "node --env-file-if-exists=.env src/media/cli.ts",
    "video": "node --env-file-if-exists=.env src/video/cli.ts",
    "video:verify": "node --env-file-if-exists=.env src/video/verify-cli.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fal-ai/client": "^1.11.0",
    "openai": "^7.59.0"
  }
}
